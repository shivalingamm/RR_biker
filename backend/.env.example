# ---------------------------------------------------------------------------
# BIKER backend environment configuration. Copy to `.env` and fill in values.
# Placeholders ONLY — never commit real secrets.
# ---------------------------------------------------------------------------

# App
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Database
# Local development (portable). Defaults to a SQLite file if unset.
# DATABASE_URL=sqlite:///./biker_dev.db
# Production example:
# DATABASE_URL=postgresql+psycopg://biker:password@localhost:5432/biker

# Auth — MUST be changed in any shared/production environment.
JWT_SECRET=dev-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File storage (private). Documents are never exposed via public URLs.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
ALLOWED_DOCUMENT_TYPES=application/pdf,image/jpeg,image/png

# AI (optional). Leave blank to run the labelled deterministic fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Maps (optional). Leave blank to run the labelled demonstration fallback.
GOOGLE_MAPS_API_KEY=

# CORS — comma-separated origins, or * for development.
CORS_ORIGINS=*
